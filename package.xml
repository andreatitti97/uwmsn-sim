<?xml version="1.0"?>
<package format="2">
  <name>uwmsn-sim</name>
  <version>0.1.0</version>
  <description>Kinematic simulator for underwater mobile sensor networks, including AUV motion, target dynamics, logging, and data visualization utilities.</description>

  <maintainer email="andrea.tiranti@edu.unige.it">Andrea Tiranti</maintainer>
  <author email="andrea.tiranti@edu.unige.it">Andrea Tiranti</author>

  <license>MIT</license>

  <url type="repository">https://github.com/your-username/uwmsn-project</url>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>uwmsn_msgs</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>uwmsn_msgs</exec_depend>

  <export>
  </export>
</package>
